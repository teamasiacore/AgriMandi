# =========================================================
# AgriMandi Maharashtra Environment Variables Template
# Copy this file to .env in local development. Never commit real secrets.
# =========================================================

# Application & Network
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:5173
API_URL=http://localhost:4000

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/agrimandi?schema=public
DIRECT_DATABASE_URL=postgresql://postgres:password@localhost:5432/agrimandi?schema=public

# Supabase Auth & Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Security & Session
JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-chars
COOKIE_SECRET=replace-with-a-secure-cookie-secret-at-least-32-chars

# Cache & Queues
REDIS_URL=redis://localhost:6379
STORAGE_BUCKET=agrimandi-media

# Reference Market Data Feeds (Backend Ingestion Only)
AGMARKNET_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
AGMARKNET_API_KEY=your-data-gov-in-api-key
MSAMB_API_URL=
MSAMB_API_KEY=

# Weather Services
WEATHER_PROVIDER=open_meteo
WEATHER_API_BASE_URL=https://api.open-meteo.com
WEATHER_API_KEY=
WEATHER_COMMERCIAL_PLAN=
IMD_WEATHER_API_URL=
IMD_WEATHER_API_KEY=

# Map & Geospatial Services (Frontend VITE_ must be domain-restricted)
VITE_MAP_PROVIDER=maptiler
VITE_MAPTILER_KEY=your-restricted-maptiler-key
VITE_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json
MAPTILER_SERVER_KEY=your-maptiler-server-key
ROUTING_PROVIDER=maptiler
ROUTING_API_URL=
ROUTING_API_KEY=
GEOCODING_PROVIDER=maptiler
GEOCODING_API_URL=
GEOCODING_API_KEY=

# Language & Communication Providers
BHASHINI_API_URL=
BHASHINI_API_KEY=
SMS_PROVIDER_URL=
SMS_PROVIDER_KEY=
WHATSAPP_PROVIDER_URL=
WHATSAPP_PROVIDER_KEY=

# ML Service Integration
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TOKEN=your-private-ml-auth-token

# Monitoring & Diagnostics
SENTRY_DSN=
